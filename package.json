{
  "name": "boardgame-playroom",
  "version": "0.21.0",
  "private": true,
  "description": "Browser tabletop app and independent game-pack engine",
  "scripts": {
    "build": "python3 build.py",
    "test": "node scripts/codex/test.cjs all",
    "test:core-ui": "node scripts/codex/test.cjs core-ui",
    "setup": "bash scripts/codex/setup.sh",
    "check": "bash scripts/codex/check.sh",
    "check:full": "bash scripts/codex/check.sh --full",
    "serve": "bash scripts/codex/serve.sh",
    "prepare:dev": "python3 build.py --prepare-dev",
    "test:app": "node scripts/codex/test.cjs app",
    "test:core": "node scripts/codex/test.cjs core",
    "test:input": "node scripts/codex/test.cjs input",
    "test:games": "node scripts/codex/test.cjs games",
    "test:ui": "node scripts/codex/test.cjs ui",
    "test:storage": "node scripts/codex/test.cjs storage",
    "test:network": "node scripts/codex/test.cjs network",
    "test:pairing": "node scripts/codex/test.cjs pairing",
    "test:layout": "node scripts/codex/test.cjs layout",
    "test:smoke": "node scripts/codex/test.cjs smoke",
    "test:rtc": "node scripts/codex/test.cjs rtc",
    "test:changed": "node scripts/codex/test.cjs --changed",
    "build:sandbox": "node scripts/build-sandbox.cjs"
  },
  "devDependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "acorn": "8.15.0",
    "esbuild": "0.25.12",
    "playwright-core": "1.63.0",
    "quickjs-emscripten": "0.32.0",
    "quickjs-emscripten-core": "0.32.0",
    "saxes": "6.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
